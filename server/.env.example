# ──────────────────────────────────────────────
# OpenHuman Server — Environment Configuration
# Copy to .env and adjust values
# ──────────────────────────────────────────────

# Server
OPENHUMAN_HOST=0.0.0.0
OPENHUMAN_PORT=8080
OPENHUMAN_BACKEND=memory # or: postgres

# PostgreSQL (only when OPENHUMAN_BACKEND=postgres)
DATABASE_URL=postgres://openhuman:openhuman@localhost:5432/openhuman

# Backpressure
OPENHUMAN_MAX_BODY_BYTES=8388608
OPENHUMAN_MAX_CONCURRENCY=256

# Reply behavior
OPENHUMAN_REPLY_TIMEOUT_SECS=300
OPENHUMAN_MERGE_WINDOW_MS=2000
OPENHUMAN_KEEPALIVE_SECS=5
OPENHUMAN_ASYNC_MODE= # set to "always" to never block on a human
OPENHUMAN_MOCK_ENDPOINTS= # set to "1" to enable /v1/mock/* (dev/test only)

# Presence notices streamed before the human answers
OPENHUMAN_ACK_ONLINE= # set to "0" to skip the online notice
OPENHUMAN_ONLINE_MESSAGE=
OPENHUMAN_OFFLINE_MESSAGE=
OPENHUMAN_ONLINE_NOTICE=

# Offline push
FIREBASE_KEY_PATH=/app/firebase-key.json
DEFAULT_FCM_DEVICE_TOKEN=
NOTIFICATION_WEBHOOK_URL=
SERVER_PUBLIC_URL=

# Logging
RUST_LOG=openhuman_server=info,tower_http=info
